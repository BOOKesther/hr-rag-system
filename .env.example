HR_DATA_DIR=data
HR_HOST=127.0.0.1
HR_PORT=8000
HR_UI_MODE=mounted
HR_API_URL=http://127.0.0.1:8000
HR_UI_PORT=7860
HR_MAX_FILE_MB=20
HR_MAX_BATCH=20
HR_SNAPSHOT_DPI=120
# Optional LibreOffice executable for faithful DOCX/PPTX page rendering.
HR_SOFFICE_PATH=
HR_MASK_CONTACTS=true
HR_SHOW_PORTRAITS=false
# local-hash is a deterministic offline demo, NOT a semantic language model.
# Set provider=openai-compatible to enable real semantic embeddings.
HR_EMBEDDING_PROVIDER=local-hash
HR_ALLOW_LOCAL_MODELS=true
HR_EMBEDDING_MODEL=local-hash-v1
HR_EMBEDDING_DIM=384
HR_EMBEDDING_BASE_URL=
HR_EMBEDDING_API_KEY=
# Empty chat model means extractive evidence answers; no fabricated LLM calls.
HR_CHAT_MODEL=
HR_CHAT_BASE_URL=
HR_CHAT_API_KEY=
HR_CHAT_TEMPERATURE=0
HR_MAX_CONTEXT_CHARS=16000
HR_RRF_K=60
HR_KEYWORD_WEIGHT=1.0
HR_VECTOR_WEIGHT=1.0
HR_MIN_VECTOR_SIMILARITY=0.12
